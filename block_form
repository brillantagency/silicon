<div class="block_form">
    {% if form_bigtitle %}
        <h2 class="form_title">{{form_bigtitle}}</h2>
    {% endif %}
    
    {% if form_text %}
        <div class="form_text">{{form_text}}</div>
    {% endif %}
    
    {% if form_link %}
        {% set var = frappe.db.get_value("Web Template","Component - Form","template") %}
        {% set args = {
          "form_link": form_link,
          "form_title": form_title,
          "form_class": form_class,
          "form_height": form_height,
        } %}
        {{frappe.render_template(var,args)}}
    {% endif %}
<div>