<link rel="stylesheet" href="/files/block_banner.css">

<div class="head head--vente banner">

{% if form_link %}
<div class="banner_width_form container">
{% endif %}

    <div class="container-head banner_wrapper_content">
        {% if banner_icon %}
        <div class="picto-h banner_img"><img src="{{banner_icon}}" alt /></div>
        {% endif %}
        
        {% if banner_title %}
        <h1 class="banner_title">{{ banner_title }}</h1>
        {% endif %}

        {% if banner_text %}
        <p class="txt-h banner_text">{{ banner_text }}</p>
        {% endif %}
    </div>
    
    {% if form_link %}
    <div class="banner_wrapper_form">
        {% set var = frappe.db.get_value("Web Template","Component - Form","template") %}
        {% set args = {
          "form_link": form_link,
          "form_title": form_title,
          "form_class": form_class,
          "form_height": form_height,
        } %}
        {{frappe.render_template(var,args)}}
    </div>
    {% endif %}
    
{% if form_link %}
</div>
{% endif %}

</div>